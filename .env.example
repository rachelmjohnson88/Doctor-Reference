# Shared passphrase required to submit a new article at /submit
SUBMIT_PASSPHRASE=

# Passphrase to log into the review queue at /admin
ADMIN_PASSPHRASE=

# Upstash Redis (Vercel Marketplace integration) — without these,
# published/pending articles are stored in memory only and reset
# whenever the server restarts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
